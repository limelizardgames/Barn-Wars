{
  "name": "barn-wars",
  "version": "0.1.0",
  "private": true,
  "description": "3D multiplayer barnyard brawler — pick an animal and wage war on the rest of the farm.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vite": "^8.3.1"
  }
}
